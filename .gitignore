# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments (if you add one later)
.venv/
venv/
env/

# IDE / editor
.idea/
.vscode/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local APK packaging / zip exports
*.zip
*.apk
*.aab
# Keep the published sample APK in the repo
!apk-sample-output/
!apk-sample-output/**/*.apk

# Old / alternate generator output (create_pages.py writes to release/main/)
pages/

# Color experiments (local only; not needed to run the reader)
page_background_color_samples/

# Editor / backup copies
*.bak
*.backup
*backup_do_not_delete*
